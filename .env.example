# Sulha — copy to `.env` (read by both Next and the Prisma CLI). Never commit `.env`.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Demo ────────────────────────────────────────────────────────────────────
# Bearer token for the institutional API (docs/institutional-api.md).
INSTITUTION_API_TOKEN=sulha-demo-institution-2026
# SLA countdown compressed for the live demo.
DEMO_SLA_MINUTES=3

# ── AI (Claude via Azure Foundry) ───────────────────────────────────────────
# Set true to force AI on, or leave false and set ANTHROPIC_FOUNDRY_API_KEY — AI auto-enables when a key is present (same gate as OCR).
AI_ENABLED=false
AI_MODEL=claude-opus-4-8
FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=

# ── Ledger ──────────────────────────────────────────────────────────────────
# `memory` is the zero-setup default. `anvil` needs the vars below + contracts/ deployed.
LEDGER=memory
ANVIL_RPC_URL=http://127.0.0.1:8545
LEDGER_CONTRACT_ADDRESS=
RELAYER_PRIVATE_KEY=
